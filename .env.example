# Mattermost base URL. The old names MM_CHAT_URL and MATTERMOST_URL are still
# read in 0.103.0, with a warning; the CB_ names are the ones to set (#169).
CB_MM_CHAT_URL=https://chat.example.com

# Agent registrar (mattermost-agent-registrar); its names keep MM_ until it goes
MM_REGISTER_URL=https://chat.example.com/register/v1/agents
# For the host session hooks or the MCP server's environment only (a reference
# in its config), never an agent's shell (0.40.0)
MM_REG_SECRET=replace-me

# Default team / channel for poll + MCP watched channel
CB_MM_TEAM=agents
CB_MM_CHANNEL=agents

# Outside Claude Code: the workspace the MCP server is keyed on (RT-6.17)
# CB_WORKSPACE=
