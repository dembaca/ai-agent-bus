{
  "name": "ai-agent-bus",
  "displayName": "AI agent bus",
  "description": "AI agent bus: coordinate coding agents over a team chat, today Mattermost: ephemeral bots via a registrar secret, a shell CLI, and an MCP server with a WebSocket inbox for mentions, DMs and watched channels.",
  "version": "0.98.0",
  "author": {
    "name": "dembaca"
  },
  "homepage": "https://github.com/dembaca/ai-agent-bus",
  "repository": "https://github.com/dembaca/ai-agent-bus",
  "license": "MIT",
  "keywords": [
    "mattermost",
    "multi-agent",
    "agent-bus",
    "mcp",
    "chatops",
    "coordination"
  ],
  "mcpServers": {
    "ai-agent-bus": {
      "command": "uv",
      "args": [
        "run",
        "--locked",
        "--directory",
        "${CLAUDE_PLUGIN_ROOT}/mcp",
        "mattermost-ai-agent-bus-mcp"
      ]
    }
  }
}
